# ========================================================
# CodingHub Frontend (Next.js) - Environment Variables
# ========================================================

# Database (used by Better Auth server adapter in Next.js)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0
DB_NAME=CodingHub

# Better Auth Configuration
# Secret key used to encrypt and sign Better Auth session cookies (generate with openssl rand -base64 32)
BETTER_AUTH_SECRET=your_better_auth_secret_here

# Frontend Canonical URL (no trailing slash)
# Local: http://localhost:3000
# Production: https://<your-frontend-project>.vercel.app
BETTER_AUTH_URL=https://<your-frontend-project>.vercel.app
NEXT_PUBLIC_APP_URL=https://<your-frontend-project>.vercel.app

# Backend Express API URL (no trailing slash)
# Used by Next.js rewrites to proxy /api/* requests to your backend
# Local: http://localhost:5000
# Production: https://<your-backend-project>.vercel.app
BACKEND_URL=https://<your-backend-project>.vercel.app
# Optional: Set only if bypassing Next.js rewrites for direct client-to-backend calls
# NEXT_PUBLIC_BACKEND_URL=https://<your-backend-project>.vercel.app

# Cloudinary (Client-Side Direct Uploads)
NEXT_PUBLIC_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_UPLOAD_PRESET=your_upload_preset_name

# Optional Custom Domain Cookie Configuration (Only needed when using custom root domains like .mycodinghub.com)
# COOKIE_DOMAIN=.mycodinghub.com

